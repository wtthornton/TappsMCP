#!/usr/bin/env bash
# TappsMCP git pre-commit hook (TAP-979)
# Runs `tapps-mcp validate-changed --quick` on staged Python files,
# ratcheted against the branch's merge target (TAP-6911).
# Bypass with TAPPS_SKIP_GATE=1, logged to .tapps-mcp/.bypass-log.jsonl.

set -e

COMMIT_LOG_DIR=".tapps-mcp"

if [ "${TAPPS_SKIP_GATE:-}" = "1" ]; then
  # Log to the same ledger as the pre-push bypass. Echoing to stderr alone
  # left commit-gate bypasses with no durable trace, so nobody could count
  # them and `tapps doctor` under-reported bypass pressure.
  mkdir -p "$COMMIT_LOG_DIR" 2>/dev/null || true
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  staged="$(git diff --cached --name-only --diff-filter=ACM | paste -sd, - || true)"
  printf '{"ts":"%s","hook":"pre-commit","reason":"TAPPS_SKIP_GATE=1","staged":"%s"}\n' \
    "$ts" "$staged" \
    >> "$COMMIT_LOG_DIR/.bypass-log.jsonl" 2>/dev/null || true
  echo "tapps-mcp pre-commit: bypassed via TAPPS_SKIP_GATE=1. Logged to $COMMIT_LOG_DIR/.bypass-log.jsonl" >&2
  exit 0
fi

# Collect staged .py files (added/copied/modified).
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
if [ -z "$STAGED_PY" ]; then
  exit 0
fi

# Resolve the tapps-mcp CLI: prefer `uv run`, fall back to PATH.
if command -v uv >/dev/null 2>&1; then
  RUNNER=(uv run tapps-mcp)
elif command -v tapps-mcp >/dev/null 2>&1; then
  RUNNER=(tapps-mcp)
else
  echo "tapps-mcp pre-commit: no `uv` or `tapps-mcp` on PATH; skipping (install tapps-mcp or set TAPPS_SKIP_GATE=1 to silence)" >&2
  exit 0
fi

echo "tapps-mcp pre-commit: validating $(echo "$STAGED_PY" | wc -l | tr -d ' ') staged Python file(s)..." >&2
# Validate exactly the staged files -- without --file-paths the CLI
# auto-detects all branch-changed files and can trip the validation cap.
STAGED_CSV=$(echo "$STAGED_PY" | paste -sd, -)
# TAP-6911: derive a local stand-in for CI's PR-base ratchet baseline.
#
# CI (tapps-quality.yml) ratchets against `github.event.pull_request.base.sha`
# -- a value only a PR has. A local commit has no PR, so the honest
# equivalent is "the merge target this branch will land on": the commit
# where it diverged from upstream. gates/ratchet.py's own contract (see its
# "Monotonicity" docstring) depends on baseline_ref being that stable merge
# target -- a prior attempt here passed `--baseline-ref HEAD` (TAP-6904,
# #329), which ratchets each commit against its own immediate predecessor
# instead. On a branch with more than one commit that reintroduces the same
# deadlock one layer down: an intermediate commit that dips below its
# sibling commit's score (while still holding above the true merge target)
# gets rejected locally even though CI, which only ever compares the PR's
# final diff against the merge-base, would accept it.
#
# We resolve the merge target in three steps, each a fallback for when the
# previous one isn't set up --
#   1. the branch's own tracking ref (`@{upstream}`), the most specific
#      answer when it exists;
#   2. the remote's default branch pointer (`origin/HEAD`), for a branch
#      that isn't tracking anything but the repo still has one;
#   3. common default-branch names (`origin/master`, `origin/main`), for a
#      repo where `origin/HEAD` was never set (older clones, some CI
#      checkouts).
# Then `git merge-base HEAD "$target"` finds the actual divergence point,
# mirroring what a PR base SHA would be once one exists.
#
# This intentionally stays undetermined (empty BASELINE_REF, no
# --baseline-ref flag, unchanged strict behaviour) rather than guessing, for:
#   - a detached HEAD with no origin/HEAD and no origin/master|main --
#     merge-base has nothing to target;
#   - a fresh repo with no origin remote -- no candidate resolves;
#   - a branch whose history shares no common ancestor with the target
#     (orphan branch, foreign import) -- `git merge-base` itself fails;
#   - a repo with no commits yet (first commit being staged) -- HEAD does
#     not resolve, so every candidate lookup fails.
# In every one of those, the gate must refuse exactly as it does today, not
# silently stop ratcheting -- an undeterminable baseline is not permission
# to skip the check.
resolve_baseline_ref() {
  local target=""

  target="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"

  if [ -z "$target" ]; then
    target="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  fi

  if [ -z "$target" ]; then
    for candidate in origin/master origin/main; do
      if git rev-parse --verify --quiet "$candidate" >/dev/null 2>&1; then
        target="$candidate"
        break
      fi
    done
  fi

  [ -z "$target" ] && return 0

  git merge-base HEAD "$target" 2>/dev/null || true
}

BASELINE_REF="$(resolve_baseline_ref)"
BASELINE_ARGS=()
if [ -n "$BASELINE_REF" ]; then
  BASELINE_ARGS=(--baseline-ref "$BASELINE_REF")
fi
if ! "${RUNNER[@]}" validate-changed --quick --file-paths "$STAGED_CSV" ${BASELINE_ARGS+"${BASELINE_ARGS[@]}"}; then
  echo "" >&2
  echo "tapps-mcp pre-commit: quality gate failed. Fix the issues above, or bypass with TAPPS_SKIP_GATE=1 git commit ..." >&2
  exit 1
fi
